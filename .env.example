# PostgreSQL connection string. Use a dedicated database/user in production.
DATABASE_URL="postgresql://kidaftari:change-me@localhost:5432/kidaftari?schema=public"

# At least 32 random characters. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Used by the protected scheduler endpoint. At least 32 random characters.
CRON_SECRET="replace-with-a-long-random-secret"

# console is safe for local development; webhook lets any SMS vendor be connected later.
SMS_PROVIDER="console"
SMS_SENDER_ID="KIDAFTARI"
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""

# Comma-separated origins allowed to submit form requests in production, e.g.
# https://app.kidaftari.co.tz
APP_ORIGIN="http://localhost:3000"

# The seed script refuses to run in production unless this is deliberately true.
ALLOW_PRODUCTION_SEED="false"
